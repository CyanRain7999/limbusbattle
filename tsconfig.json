{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleResolution": "Bundler", "resolveJsonModule": true, "allowImportingTsExtensions": true,
    "isolatedModules": true, "noEmit": true, "strict": true, "skipLibCheck": true,
    "esModuleInterop": true, "useDefineForClassFields": true, "types": ["vite/client", "node"]
  },
  "include": ["src", "tests", "vite.config.ts", "playwright.config.ts"]
}
